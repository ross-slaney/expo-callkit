  "homepage": "https://github.com/ross-slaney/expo-callkit#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "jest": {
    "preset": "expo-module-scripts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "~19.1.0",
    "expo": "~54.0.0",
    "expo-module-scripts": "^5.0.7",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
