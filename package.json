{
  "name": "@ross-slaney/expo-callkit",
  "version": "0.2.0",
  "description": "Expo module for native call UX — CallKit + PushKit on iOS, Jetpack core-telecom on Android",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "android/build.gradle",
    "android/src/main/",
    "ios/",
    "build/",
    "plugin/build/",
    "src/ExpoCallKit.types.ts",
    "src/ExpoCallKitModule.ts",
    "src/ExpoCallKitModule.web.ts",
    "src/events.ts",
    "src/index.ts",
    "src/payload.ts",
    "app.plugin.js",
    "expo-module.config.json",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "typecheck": "expo-module typecheck",
    "verify:package": "node scripts/validate-package.mjs",
    "verify:release": "node scripts/validate-release.mjs",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly && npm run verify:package",
    "expo-module": "expo-module"
  },
  "keywords": [
    "react-native",
    "expo",
    "callkit",
    "pushkit",
    "voip",
    "telecom",
    "core-telecom",
    "expo-callkit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ross-slaney/expo-callkit.git"
  },
  "bugs": {
    "url": "https://github.com/ross-slaney/expo-callkit/issues"
  },
  "author": "Ross Slaney",
  "license": "MIT",
  "homepage": "https://github.com/ross-slaney/expo-callkit#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=10.8.2"
  },
  "jest": {
    "preset": "expo-module-scripts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "~19.1.0",
    "expo": "~54.0.0",
    "expo-module-scripts": "^5.0.7",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "expo": "^54.0.0",
    "react": ">=19.1.0 <19.2.0",
    "react-native": ">=0.81.4 <0.82.0"
  }
}
